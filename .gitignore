# Generated localization files (can be regenerated)
# Uncomment if you want to commit generated l10n files:
# **/l10n/app_localizations*.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android keystore files (NEVER commit these)
*.jks
*.keystore
key.properties

# iOS/macOS signing and provisioning
**/ios/Runner.xcworkspace/xcuserdata/
**/macos/Runner.xcworkspace/xcuserdata/
**/ios/Pods/
**/macos/Pods/
*.mobileprovision
*.p12
*.cer

# Environment files with secrets
.env
.env.local
.env.*.local
*.env

# Firebase and Google Services (proprietary, F-Droid incompatible)
google-services.json
GoogleService-Info.plist
firebase_options.dart

# Sensitive data
secrets.dart
config/secrets.yaml

# Build caches
.gradle_home/

# IDE temp files
.mimocode/

# Compiled binaries
*.apk
*.aab

# Backup files
*.bak
backups/

# Android local config (machine-specific paths)
android/local.properties
# NOTE: android/gradle.properties IS committed (clean defaults).
# Machine-specific overrides (e.g. org.gradle.java.home) belong to
# %USERPROFILE%\.gradle\gradle.properties, not to this repo.
android/.gradle/
android/.kotlin/

# Flutter ephemeral plugin symlinks (regenerated by flutter pub get / build)
**/flutter/ephemeral/
**/ephemeral/.plugin_symlinks/

# Personal / fitness data (never commit)
*.fit
*.gpx
*.fb2
user_*export*/
Screenshot_*.png
