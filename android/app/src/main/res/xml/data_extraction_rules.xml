<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Disallow auto backup of DB / prefs to prevent Samsung/Google restore rolling back local edits -->
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
